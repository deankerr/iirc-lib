{
  "name": "@deankerr/iirc-lib",
  "version": "0.2.0",
  "description": "Stream-based IRC client library — wire framing, typed events, registration, CAP negotiation, SASL, and channel state. You provide the transport.",
  "keywords": [
    "irc",
    "irc-client",
    "ircv3",
    "protocol",
    "sasl",
    "typescript"
  ],
  "homepage": "https://github.com/deankerr/iirc-lib#readme",
  "bugs": "https://github.com/deankerr/iirc-lib/issues",
  "license": "MIT",
  "author": "Dean Kerr <dean.kerr@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deankerr/iirc-lib.git"
  },
  "files": [
    "dist",
    "src",
    "CHANGELOG.md",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./testing": {
      "types": "./dist/testing.d.mts",
      "default": "./dist/testing.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "check": "ultracite check --type-aware --type-check",
    "fix": "ultracite fix --type-aware --type-check",
    "lint:package": "publint --strict && attw --pack . --profile esm-only",
    "prepack": "bun run build",
    "prepare": "bunx lefthook install",
    "prepublishOnly": "bun run check && bun test",
    "release": "bun run scripts/release.ts",
    "test": "bun test"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@types/bun": "1.3.14",
    "@types/node": "24.13.3",
    "commander": "14.0.3",
    "lefthook": "2.1.9",
    "oxfmt": "0.57.0",
    "oxlint": "1.72.0",
    "oxlint-tsgolint": "0.24.0",
    "publint": "0.3.22",
    "tsdown": "0.22.0",
    "typescript": "6.0.3",
    "ultracite": "7.8.4"
  },
  "peerDependencies": {
    "@types/node": ">=24"
  },
  "peerDependenciesMeta": {
    "@types/node": {
      "optional": true
    }
  },
  "overrides": {
    "@types/node": "24.13.3"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "bun@1.3.14"
}
